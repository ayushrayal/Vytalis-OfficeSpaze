PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_ACCESS_CODE=your_admin_access_code
FRONTEND_URL=https://your-frontend-app.onrender.com
NODE_ENV=production
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
USE_CUSTOM_DNS=false
WINDSOR_API_KEY=your_windsor_api_key
WINDSOR_META_LEADS_ACCOUNT_ID=754258214430492

# CORS Allowed Origins (P0.3)
# Comma-separated list of EXACT full origins allowed to make cross-origin requests.
# No wildcard, no substring matching — each entry must be a complete origin.
# Examples:
#   https://your-frontend-app.onrender.com
#   https://admin.your-domain.com
#
# Production: Set this explicitly. If unset in production, all cross-origin
#             browser requests will be rejected (safe default).
# Development: Falls back to http://localhost:5173, http://localhost:5174,
#              http://localhost:5000, http://127.0.0.1:5000 automatically
#              when NODE_ENV is not 'production'.
#
# Variable name: CORS_ALLOWED_ORIGINS
# Used by: src/utils/corsOptions.util.js
CORS_ALLOWED_ORIGINS=https://your-frontend-app.onrender.com

# Rate Limiting & Brute-Force Protection (P0.2)
# Window durations are in milliseconds (default: 900000ms = 15 minutes)
# In-memory limiter is process-local; distributed store (Redis) required before horizontal scaling
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

AUTH_SIGNUP_RATE_LIMIT_WINDOW_MS=900000
AUTH_SIGNUP_RATE_LIMIT_MAX=5

# Proxy Trust Configuration
# Set to 1 on Render (single internal hop from Render load balancer).
# Leave unset or set to false in local development (defaults to false).
# Do NOT set to true (allows arbitrary forwarded-for chain — spoofing risk).
# This controls req.ip resolution. Rate-limit IP is separately resolved via
# getClientIp() in src/utils/clientIp.util.js using CF-Connecting-IP.
TRUST_PROXY=1

# ============================================================
# PRODUCTION SECURITY — CLOUDFLARE ORIGIN RESTRICTION
# ============================================================
#
# DIRECT_ORIGIN_STATUS: NEEDS_ENVIRONMENT_VERIFICATION
#
# The rate-limit IP fix uses CF-Connecting-IP (discriminated by CF-Ray) to
# identify real client IPs when traffic flows through Cloudflare.
#
# Software-level discriminator limitation:
#   A client that reaches the Render origin DIRECTLY (bypassing Cloudflare)
#   can forge any header, including CF-Connecting-IP and CF-Ray.
#   This cannot be mitigated in application code alone.
#
# REQUIRED INFRASTRUCTURE ACTION for full spoofing protection:
#   Option A (Recommended — Render):
#     In the Render dashboard, configure an inbound firewall rule to allow
#     traffic ONLY from Cloudflare's published IP ranges:
#       https://www.cloudflare.com/ips/
#     This ensures no direct-origin requests are possible.
#
#   Option B (Cloudflare):
#     Enable Cloudflare's "Authenticated Origin Pulls" (mTLS) feature so
#     Render can verify that requests genuinely arrived via Cloudflare.
#     https://developers.cloudflare.com/ssl/origin-configuration/authenticated-origin-pull/
#
# No environment variable needed for this action. It is a Render/Cloudflare
# dashboard configuration. Document completion of this step here once done.
#
# CLOUDFLARE_ORIGIN_ONLY_STATUS=pending|configured
# (comment-only; not read by application code — used for audit trail)

